# Normalize line endings so the repo stays consistent across machines.
# All text files are stored with LF in git; Git handles checkout per-OS.
* text=auto eol=lf

# Treat binary assets as binary (never apply line-ending conversion).
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.avif  binary
*.gif   binary
*.ico   binary
*.svg   text
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.pdf   binary
*.mp4   binary
*.zip   binary
